[Unit]
Description=Shyup task manager
After=network.target

[Service]
User=shyup
WorkingDirectory=/opt/shyup
Environment=SHYUP_DB=/var/lib/shyup/shyup.db
Environment=PORT=4000
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/env node src/cli.ts serve
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shyup
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Where the SQLite database lives. Back this file up.
SHYUP_DB=data/shyup.db
# Server port and bind address. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 in a container.
PORT=4000
HOST=127.0.0.1

# Public URL of this server. Required when sending email; sign-in links are built from it.
SHYUP_BASE_URL=
# Send sign-in emails through WeMail. Leave empty to print sign-in links to the server log.
SHYUP_WEMAIL_API_KEY=
SHYUP_WEMAIL_INBOX_ID=
SHYUP_WEMAIL_URL=https://wemail.now

# Client settings for the CLI
SHYUP_URL=http://localhost:4000
SHYUP_TOKEN=
